# Copy this file to .env and adjust values. Never commit the real .env.

# --- General -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Database ------------------------------------------------------------
# Local dev default (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./scanner.db
# Production example (Postgres):
# DATABASE_URL=postgresql+asyncpg://scanner:scanner@db:5432/scanner
POSTGRES_USER=scanner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scanner

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Scanning behaviour ------------------------------------------------------
REQUEST_TIMEOUT=10
MAX_CONCURRENCY=5
DEFAULT_CRAWL_DEPTH=3
RATE_LIMIT=5
MAX_URLS_PER_SCAN=2000
RESPECT_ROBOTS_TXT=true

# --- Security ------------------------------------------------------------
# Only set to true in an isolated lab environment where scanning localhost
# or private-network targets (e.g. a co-located vulnerable test app) is
# intentional. Never enable this in a general-purpose deployment.
ALLOW_PRIVATE_NETWORK_TARGETS=true
SECRET_KEY=change-me-in-production

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173"]
